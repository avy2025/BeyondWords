PORT=5000
# Required for isolated Sarvam saaras:v4 realtime Caption Host transcription (server-only; never expose in client).
# SARVAM_API_KEY=your-sarvam-api-key
# Required for German Gemini Live transcription and free-tier Gemini text translation (server-only; never expose in client).
# GEMINI_API_KEY=your-gemini-api-key
# Copy to .env. Use your Atlas URI or local MongoDB:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/beyond-words?retryWrites=true&w=majority
# MONGODB_URI=mongodb://127.0.0.1:27017/beyond-words

# Optional isolated Azure AI Speech F0 live subtitles (server-only; never expose in client).
# Use an F0 Speech resource in a region that supports real-time translation (for example eastus).
# AZURE_SPEECH_F0_KEY=your-speech-f0-key
# AZURE_SPEECH_F0_REGION=eastus
# Optional only when the resource has a custom subdomain:
# AZURE_SPEECH_F0_SUBDOMAIN=your-speech-resource-name
